# ─── Auth.js v5 ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Optional in dev (defaults to host); required in production.
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Database (Neon Postgres) ──────────────────────────────────────────────
# Pooled URL — used by the app at runtime.
DATABASE_URL=
# Unpooled URL — used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# ─── Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Valency MCP ───────────────────────────────────────────────────────────
# System-wide fallback token. Used by /api/health and as a fallback when a
# user has not yet stored their own token via /app/settings.
VALENCY_BEARER_TOKEN=

# ─── Encryption ────────────────────────────────────────────────────────────
# 32-byte key used to AES-256-GCM-encrypt user-supplied secrets at rest
# (e.g. per-user Valency tokens). Generate with: openssl rand -hex 32
BRIEFING_ENC_KEY=

# ─── Inngest ───────────────────────────────────────────────────────────────
# Issued at https://app.inngest.com — required in production. Locally the
# Inngest CLI dev server (`npx inngest-cli@latest dev`) proxies events for
# free without these.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Tests ─────────────────────────────────────────────────────────────────
# Enables the /api/test/login endpoint. NEVER set this in production.
E2E_TEST_MODE=

# ─── Mailgun (Phase 8+) ────────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_BASE_URL=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_WEBHOOK_SIGNING_KEY=

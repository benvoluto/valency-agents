# ─── Auth.js v5 ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Optional in dev (defaults to host); required in production.
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Database (Neon Postgres) ──────────────────────────────────────────────
# Pooled URL — used by the app at runtime.
DATABASE_URL=
# Unpooled URL — used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# ─── Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Valency MCP ───────────────────────────────────────────────────────────
# Per-user tokens are stored encrypted in `credentials` once Phase 2 ships;
# this env var is used only for the /api/health probe and Phase 3 spike scripts.
VALENCY_BEARER_TOKEN=

# ─── Mailgun (Phase 8+) ────────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_BASE_URL=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_WEBHOOK_SIGNING_KEY=
